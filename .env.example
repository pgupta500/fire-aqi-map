# Copy this file to ".env" (same folder) and paste your real keys.

# NASA FIRMS -- free key at: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=your_key_here

# OpenAQ v3 -- free key at: https://explore.openaq.org/register
OPENAQ_API_KEY=your_key_here

# Optional settings
# FIRMS satellite feed (VIIRS_SNPP_NRT is retired; NOAA20 is the default)
FIRMS_SOURCE=VIIRS_NOAA20_NRT
# How long to cache upstream API results, in seconds
CACHE_TTL_SECONDS=1800
